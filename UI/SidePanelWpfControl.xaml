<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HashTrack"
             xmlns:Collections="clr-namespace:System.Collections;assembly=mscorlib" x:Class="HashTrack.SidePanelWpfControl"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400">
    <TabControl x:Name="mainTabControl">
        <TabItem Header="Search">
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Artifact Filters" Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
            <CheckBox x:Name="ch_email" Content="Email" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_appointment" Content="Appointments" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_task" Content="Tasks" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_contact" Content="Contacts" Margin="8" IsChecked="True"/>
        </StackPanel>

        <TextBox x:Name="tb_searchbar" Grid.Row="3" Margin="10" HorizontalAlignment="Stretch" FontSize="16"/>

        <Button x:Name="btn_search" Content="Search" Grid.Row="3" Width="80" Margin="10" HorizontalAlignment="Right" Click="btn_search_Click"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="From:" VerticalAlignment="Center"/>
            <DatePicker x:Name="date_from" Margin="8"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker x:Name="date_to" Margin="8"/>
        </StackPanel>
        <ListView x:Name="list_searchResults" Grid.Row="5" HorizontalAlignment="Stretch" Width="Auto" SelectionChanged="list_searchResults_SelectionChanged">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}" Grid.Row="0"/>
                            <TextBlock Text="{Binding Sender}" Grid.Row="1"/>
                            <TextBlock Text="{Binding Date}" Grid.Row="2"/>
                            <TextBlock Text="{Binding Type}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="3" Margin="0,5,5,5" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
            </Grid>
        </TabItem>

        <!-- Hashtags Overview Tab -->
        <TabItem Header="Hashtags Overview">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Button Content="Start Indexing" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Top" Click="StartIndexing_Click"/>
                <ListView x:Name="list_Hashtags" Grid.Row="1" Margin="10" SelectionMode="Single" SelectionChanged="list_Hashtags_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HashTag}" FontWeight="Bold"/>
                                    <TextBlock Text=" - "/>
                                    <TextBlock Text="{Binding NumOfOccurences}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
