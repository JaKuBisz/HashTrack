<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HashTrack"
             xmlns:Collections="clr-namespace:System.Collections;assembly=mscorlib" x:Class="HashTrack.SidePanelWpfControl"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="400">
    <TabControl x:Name="mainTabControl">
        <TabItem Header="Search">
            <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Artifact Filters" Grid.Row="0" FontSize="14" FontWeight="Bold" Margin="10" HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0">
            <CheckBox x:Name="ch_email" Content="Email" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_appointment" Content="Appointments" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_task" Content="Tasks" Margin="8" IsChecked="True"/>
            <CheckBox x:Name="ch_contact" Content="Contacts" Margin="8" IsChecked="True"/>
        </StackPanel>
                
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0" HorizontalAlignment="Center">
            <TextBlock Text="From:" VerticalAlignment="Center"/>
            <DatePicker x:Name="date_from" Margin="8"/>
            <TextBlock Text="To:" VerticalAlignment="Center" Margin="10,0,0,0"/>
            <DatePicker x:Name="date_to" Margin="8"/>
        </StackPanel>
                
        <TextBox x:Name="tb_searchbar" Grid.Row="3" Margin="5,3" HorizontalAlignment="Stretch" FontSize="16"/>
        <Button x:Name="btn_search" Content="Search" Grid.Row="3" Width="80" Margin="5,3"  HorizontalAlignment="Right" Click="btn_search_Click"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="10, 5" HorizontalAlignment="Right">
            <TextBlock Text="Order by:" VerticalAlignment="Center"/>
                <ComboBox x:Name="cb_order_by" Margin="8,0,0,0">
                    <ComboBoxItem Content="Date" IsSelected="True"/>
                    <ComboBoxItem Content="Title"/>
                    <ComboBoxItem Content="Sender"/>
                </ComboBox>
        </StackPanel>
        <ListView x:Name="list_searchResults" Grid.Row="5" HorizontalAlignment="Stretch" Width="Auto">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="MouseDoubleClick" Handler="list_searchResults_MouseDoubleClick"/>
                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{Binding Title}" Grid.Row="0"/>
                            <TextBlock Text="{Binding Sender}" Grid.Row="1"/>
                            <TextBlock Text="{Binding Date}" Grid.Row="2"/>
                            <TextBlock Text="{Binding Type}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Grid.Row="3" Margin="0,5,5,5" FontStyle="Italic"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
            </Grid>
        </TabItem>

        <!-- Hashtags Overview Tab -->
        <TabItem Header="Hashtags Overview">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10, 5" HorizontalAlignment="Center">
                    <TextBlock Text="From:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="index_date_from" VerticalAlignment="Center" Margin="3, 10"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="3, 0, 0, 0"/>
                    <DatePicker x:Name="index_date_to" Margin="3, 10"/>
                    <Button Content="Re-index" Grid.Row="3" HorizontalAlignment="Center" Margin="10" VerticalAlignment="Top" Click="StartIndexing_Click"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5, 5" HorizontalAlignment="Center">
                    <TextBlock Text="Num usages From:" VerticalAlignment="Center"/>
                    <TextBox x:Name="index_tb_num_from" Width="50" VerticalAlignment="Center" Margin="3, 10"/>
                    <TextBlock Text="To:" VerticalAlignment="Center" Margin="3, 0, 0, 0"/>
                    <TextBox x:Name="index_tb_num_to" Width="50" Margin="3, 10"/>
                    <TextBlock Text="Order by:" VerticalAlignment="Center" Margin="5,10,0,10"/>
                    <ComboBox x:Name="index_cb_order_by" Margin="5,10,0,10" SelectionChanged="index_cb_order_by_SelectionChanged">
                        <ComboBoxItem Content="Most used" IsSelected="True"/>
                        <ComboBoxItem Content="Most recent"/>
                        <ComboBoxItem Content="Least used"/>
                    </ComboBox>

                </StackPanel>

                <TextBox x:Name="index_tb_searchbar" Grid.Row="3" Margin="5,3" HorizontalAlignment="Stretch" FontSize="16"/>
                <!-- <Button x:Name="index_btn_search" Content="Search" Grid.Row="3" Width="80" Margin="5,3"  HorizontalAlignment="Right" Click="btn_search_Click"/> -->
                
                <ListView x:Name="list_Hashtags" Grid.Row="5" Margin="10" SelectionMode="Single">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <EventSetter Event="MouseDoubleClick" Handler="list_Hashtags_MouseDoubleClick"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding HashTag}" FontWeight="Bold"/>
                                    <TextBlock Text=" - "/>
                                    <TextBlock Text="{Binding NumOfOccurences}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
